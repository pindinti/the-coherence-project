---
import type { CollectionEntry } from 'astro:content';
import { getCollection, render } from 'astro:content';
import PublicationLayout from '../../layouts/PublicationLayout.astro';

export async function getStaticPaths() {
  const content = await getCollection('content');
  const articlesPt = content.filter((entry) =>
    entry.data.language === 'pt' &&
    entry.data.type === 'article' &&
    entry.data.status === 'published' &&
    entry.data.publicationMode !== 'external'
  ).sort((a, b) => b.data.date.getTime() - a.data.date.getTime());
  const articlesEn = content.filter((entry) =>
    entry.data.language === 'en' &&
    entry.data.type === 'article' &&
    entry.data.status === 'published' &&
    entry.data.publicationMode !== 'external'
  );

  return articlesPt.map((article, index) => {
    const enMatch = article.data.translationId
      ? articlesEn.find((entry) => entry.data.translationId === article.data.translationId)
      : undefined;

    return {
      params: { slug: article.id.split('/').pop()! },
      props: {
        article,
        enSlug: enMatch?.id.split('/').pop(),
        previous: articlesPt[index - 1]
          ? {
              href: `/artigos/${articlesPt[index - 1].id.split('/').pop()!}`,
              title: articlesPt[index - 1].data.title,
            }
          : undefined,
        next: articlesPt[index + 1]
          ? {
              href: `/artigos/${articlesPt[index + 1].id.split('/').pop()!}`,
              title: articlesPt[index + 1].data.title,
            }
          : undefined,
      },
    };
  });
}

interface Props {
  article: CollectionEntry<'content'>;
  enSlug?: string;
  previous?: { href: string; title: string };
  next?: { href: string; title: string };
}

const { article, enSlug, previous, next } = Astro.props;
const { Content } = await render(article);
const slug = article.id.split('/').pop()!;
const ptPath = `/artigos/${slug}`;
const enPath = enSlug ? `/en/articles/${enSlug}` : undefined;
---

<PublicationLayout
  title={article.data.title}
  subtitle={article.data.subtitle}
  description={article.data.description}
  date={article.data.date}
  series={article.data.series}
  language="pt"
  canonical={article.data.canonicalUrl ?? ptPath}
  hreflangEn={enPath}
  hreflangPt={ptPath}
  languagePathEn={enPath ?? '/en/'}
  languagePathPt={ptPath}
  readingNavigation={{
    collection: 'articles',
    language: 'pt',
    backHref: '/artigos/',
    previous,
    next,
  }}
>
  <Content />
</PublicationLayout>
