---
/**
 * PT Essay Dynamic Route — /pt/ensaios/[slug]
 * The Coherence Project
 *
 * Gera uma página estática por ensaio publicado em português na coleção `content`.
 * Resolve a tradução correspondente em inglês via `translationId` para
 * popular o hreflang EN alternate.
 *
 * Architecture ref: 11_URL_and_Routing_Strategy.md — Content Directory vs URL Mapping
 */

import type { CollectionEntry } from 'astro:content';
import { getCollection, render } from 'astro:content';
import EssayLayout from '../../../layouts/EssayLayout.astro';

export async function getStaticPaths() {
  const content = await getCollection('content');
  const essaysPt = content.filter(
    (entry) =>
      entry.data.language === 'pt' &&
      entry.data.type === 'essay' &&
      entry.data.status === 'published',
  );
  const essaysEn = content.filter(
    (entry) =>
      entry.data.language === 'en' &&
      entry.data.type === 'essay' &&
      entry.data.status === 'published',
  );

  return essaysPt.map((essay) => {
    const slug = essay.id.split('/').pop()!;

    // Locate the matching EN translation via translationId
    const enMatch = essay.data.translationId
      ? essaysEn.find((en) => en.data.translationId === essay.data.translationId)
      : undefined;

    const enSlug = enMatch ? enMatch.id.split('/').pop()! : undefined;

    return {
      params: { slug },
      props: { essay, enSlug },
    };
  });
}

interface Props {
  essay: CollectionEntry<'content'>;
  enSlug?: string;
}

const { essay, enSlug } = Astro.props;
const { Content } = await render(essay);

const slug = essay.id.split('/').pop()!;
const ptPath = `/pt/ensaios/${slug}`;
// Fall back to EN homepage if no translation is available
const enPath = enSlug ? `/en/essays/${enSlug}` : '/en/';
---

<EssayLayout
  title={essay.data.title}
  subtitle={essay.data.subtitle}
  description={essay.data.description}
  date={essay.data.date}
  series={essay.data.series}
  language="pt"
  hreflangEn={enPath}
  hreflangPt={ptPath}
>
  <Content />
</EssayLayout>
