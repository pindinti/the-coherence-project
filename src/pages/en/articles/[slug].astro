---
import type { CollectionEntry } from 'astro:content';
import { getCollection, render } from 'astro:content';
import PublicationLayout from '../../../layouts/PublicationLayout.astro';

export async function getStaticPaths() {
  const content = await getCollection('content');
  const articlesEn = content.filter((entry) =>
    entry.data.language === 'en' &&
    entry.data.type === 'article' &&
    entry.data.status === 'published' &&
    entry.data.publicationMode !== 'external'
  );
  const articlesPt = content.filter((entry) =>
    entry.data.language === 'pt' &&
    entry.data.type === 'article' &&
    entry.data.status === 'published' &&
    entry.data.publicationMode !== 'external'
  );

  return articlesEn.map((article) => {
    const ptMatch = article.data.translationId
      ? articlesPt.find((entry) => entry.data.translationId === article.data.translationId)
      : undefined;

    return {
      params: { slug: article.id.split('/').pop()! },
      props: { article, ptSlug: ptMatch?.id.split('/').pop() },
    };
  });
}

interface Props {
  article: CollectionEntry<'content'>;
  ptSlug?: string;
}

const { article, ptSlug } = Astro.props;
const { Content } = await render(article);
const slug = article.id.split('/').pop()!;
const enPath = `/en/articles/${slug}`;
const ptPath = ptSlug ? `/artigos/${ptSlug}` : undefined;
---

<PublicationLayout
  title={article.data.title}
  subtitle={article.data.subtitle}
  description={article.data.description}
  date={article.data.date}
  series={article.data.series}
  language="en"
  canonical={article.data.canonicalUrl ?? enPath}
  hreflangEn={enPath}
  hreflangPt={ptPath}
  languagePathEn={enPath}
  languagePathPt={ptPath ?? '/'}
>
  <Content />
</PublicationLayout>
