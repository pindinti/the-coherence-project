---
import type { CollectionEntry } from 'astro:content';
import { getCollection, render } from 'astro:content';
import PublicationLayout from '../../../layouts/PublicationLayout.astro';

export async function getStaticPaths() {
  const content = await getCollection('content');
  const entriesEn = content.filter((entry) =>
    entry.data.language === 'en' &&
    entry.data.type === 'journal' &&
    entry.data.status === 'published'
  ).sort((a, b) => b.data.date.getTime() - a.data.date.getTime());
  const entriesPt = content.filter((entry) =>
    entry.data.language === 'pt' &&
    entry.data.type === 'journal' &&
    entry.data.status === 'published'
  );

  return entriesEn.map((entry, index) => {
    const ptMatch = entry.data.translationId
      ? entriesPt.find((candidate) => candidate.data.translationId === entry.data.translationId)
      : undefined;

    return {
      params: { slug: entry.id.split('/').pop()! },
      props: {
        entry,
        ptSlug: ptMatch?.id.split('/').pop(),
        previous: entriesEn[index + 1]
          ? {
              href: `/en/journal/${entriesEn[index + 1].id.split('/').pop()!}`,
              title: entriesEn[index + 1].data.title,
            }
          : undefined,
        next: entriesEn[index - 1]
          ? {
              href: `/en/journal/${entriesEn[index - 1].id.split('/').pop()!}`,
              title: entriesEn[index - 1].data.title,
            }
          : undefined,
      },
    };
  });
}

interface Props {
  entry: CollectionEntry<'content'>;
  ptSlug?: string;
  previous?: { href: string; title: string };
  next?: { href: string; title: string };
}

const { entry, ptSlug, previous, next } = Astro.props;
const { Content } = await render(entry);
const slug = entry.id.split('/').pop()!;
const enPath = `/en/journal/${slug}`;
const ptPath = ptSlug ? `/diario/${ptSlug}` : undefined;
---

<PublicationLayout
  title={entry.data.title}
  subtitle={entry.data.subtitle}
  description={entry.data.description}
  date={entry.data.date}
  series={entry.data.series}
  language="en"
  canonical={entry.data.canonicalUrl ?? enPath}
  hreflangEn={enPath}
  hreflangPt={ptPath}
  languagePathEn={enPath}
  languagePathPt={ptPath ?? '/'}
  readingNavigation={{
    collection: 'journal',
    language: 'en',
    backHref: '/en/journal/',
    previous,
    next,
  }}
>
  <Content />
</PublicationLayout>
