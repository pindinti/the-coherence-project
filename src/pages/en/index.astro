---
/**
 * EN Homepage — /en/
 * The Coherence Project
 *
 * Lists published essays in English, sorted by date descending.
 * Architecture ref: 11_URL_and_Routing_Strategy.md — Language Namespaces
 */

import { getCollection } from 'astro:content';
import BaseLayout from '../../layouts/BaseLayout.astro';

const essays = (await getCollection('content'))
  .filter(
    (entry) =>
      entry.data.language === 'en' &&
      entry.data.type === 'essay' &&
      entry.data.status === 'published',
  )
  .sort((a, b) => b.data.date.getTime() - a.data.date.getTime());
---

<BaseLayout
  title="The Coherence Project"
  description="Essays, articles and research notes on organizational coherence, strategy, and capability."
  lang="en"
  hreflangEn="/en/"
  hreflangPt="/pt/"
>
  <div class="page">
    <header class="page-header">
      <a href="/" class="page-back" aria-label="Back to language selection">
        The Coherence Project
      </a>
      <h1 class="page-title">Essays</h1>
    </header>

    <main class="page-main">
      {essays.length > 0 ? (
        <ul class="essay-list" role="list">
          {essays.map((essay) => {
            const slug = essay.id.split('/').pop()!;
            return (
              <li class="essay-item">
                <a href={`/en/essays/${slug}`} class="essay-link">
                  <article class="essay-card">
                    {essay.data.series && (
                      <span class="essay-card-series">{essay.data.series}</span>
                    )}
                    <h2 class="essay-card-title">{essay.data.title}</h2>
                    {essay.data.subtitle && (
                      <p class="essay-card-subtitle">{essay.data.subtitle}</p>
                    )}
                    <p class="essay-card-description">{essay.data.description}</p>
                    <time
                      class="essay-card-date"
                      datetime={essay.data.date.toISOString()}
                    >
                      {essay.data.date.toLocaleDateString('en-US', {
                        year: 'numeric',
                        month: 'long',
                        day: 'numeric',
                      })}
                    </time>
                  </article>
                </a>
              </li>
            );
          })}
        </ul>
      ) : (
        <p class="empty-state">No published essays yet.</p>
      )}
    </main>
  </div>
</BaseLayout>

<style>
  .page {
    max-width: var(--max-width-content);
    margin-inline: auto;
    padding: var(--space-16) var(--space-6);
  }

  .page-header {
    margin-bottom: var(--space-12);
  }

  .page-back {
    display: inline-block;
    font-size: var(--text-sm);
    color: var(--color-text-muted);
    text-decoration: none;
    margin-bottom: var(--space-4);
    transition: color var(--transition-fast);
  }

  .page-back:hover {
    color: var(--color-text-secondary);
  }

  .page-title {
    font-size: var(--text-4xl);
    font-weight: var(--weight-bold);
    letter-spacing: -0.02em;
  }

  .essay-list {
    list-style: none;
    display: flex;
    flex-direction: column;
    max-width: 56rem;
  }

  .essay-item:not(:last-child) {
    border-bottom: 1px solid var(--color-border);
  }

  .essay-link {
    display: block;
    text-decoration: none;
    color: inherit;
    padding: var(--space-8) 0;
    transition: opacity var(--transition-fast);
  }

  .essay-link:hover {
    opacity: 0.7;
  }

  .essay-card-series {
    display: inline-block;
    font-size: var(--text-xs);
    font-weight: var(--weight-semibold);
    color: var(--color-accent);
    text-transform: uppercase;
    letter-spacing: 0.1em;
    margin-bottom: var(--space-3);
  }

  .essay-card-title {
    font-size: var(--text-2xl);
    font-weight: var(--weight-semibold);
    line-height: var(--leading-snug);
    margin-bottom: var(--space-2);
  }

  .essay-card-subtitle {
    font-size: var(--text-base);
    color: var(--color-text-secondary);
    font-style: italic;
    line-height: var(--leading-snug);
    margin-bottom: var(--space-4);
  }

  .essay-card-description {
    font-size: var(--text-sm);
    color: var(--color-text-secondary);
    line-height: var(--leading-relaxed);
    margin-bottom: var(--space-4);
    max-width: 52ch;
  }

  .essay-card-date {
    font-size: var(--text-xs);
    color: var(--color-text-muted);
  }

  .empty-state {
    color: var(--color-text-muted);
    font-style: italic;
    padding: var(--space-8) 0;
  }

  @media (max-width: 768px) {
    .page {
      padding: var(--space-8) var(--space-4);
    }

    .page-title {
      font-size: var(--text-3xl);
    }

    .essay-card-title {
      font-size: var(--text-xl);
    }
  }
</style>
