---
/**
 * EN Essay Dynamic Route — /en/essays/[slug]
 * The Coherence Project
 *
 * Generates one static page per published essay in the `essays-en` collection.
 * Resolves the corresponding Portuguese translation via `translationId` to
 * populate the hreflang PT alternate.
 *
 * Architecture ref: 11_URL_and_Routing_Strategy.md — Internal Collection vs URL Mapping
 */

import type { CollectionEntry } from 'astro:content';
import { getCollection, render } from 'astro:content';
import EssayLayout from '../../../layouts/EssayLayout.astro';

export async function getStaticPaths() {
  const essaysEn = await getCollection('essays-en');
  const essaysPt = await getCollection('essays-pt');

  return essaysEn.map((essay) => {
    // Strip .md extension to produce the URL slug
    const slug = essay.id.replace(/\.md$/, '');

    // Locate the matching PT translation via translationId
    const ptMatch = essay.data.translationId
      ? essaysPt.find((pt) => pt.data.translationId === essay.data.translationId)
      : undefined;

    const ptSlug = ptMatch ? ptMatch.id.replace(/\.md$/, '') : undefined;

    return {
      params: { slug },
      props: { essay, ptSlug },
    };
  });
}

interface Props {
  essay: CollectionEntry<'essays-en'>;
  ptSlug?: string;
}

const { essay, ptSlug } = Astro.props;
const { Content } = await render(essay);

const slug = essay.id.replace(/\.md$/, '');
const enPath = `/en/essays/${slug}`;
// Fall back to PT homepage if no translation is available
const ptPath = ptSlug ? `/pt/ensaios/${ptSlug}` : '/pt/';
---

<EssayLayout
  title={essay.data.title}
  subtitle={essay.data.subtitle}
  description={essay.data.description}
  date={essay.data.date}
  series={essay.data.series}
  language="en"
  hreflangEn={enPath}
  hreflangPt={ptPath}
>
  <Content />
</EssayLayout>
