---
/**
 * EN Essay Dynamic Route — /en/essays/[slug]
 * The Coherence Project
 *
 * Generates one static page per published English essay in the `content` collection.
 * Resolves the corresponding Portuguese translation via `translationId` to
 * populate the hreflang PT alternate.
 *
 * Architecture ref: 11_URL_and_Routing_Strategy.md — Content Directory vs URL Mapping
 */

import type { CollectionEntry } from 'astro:content';
import { getCollection, render } from 'astro:content';
import EssayLayout from '../../../layouts/EssayLayout.astro';

export async function getStaticPaths() {
  const content = await getCollection('content');
  const essaysEn = content.filter(
    (entry) =>
      entry.data.language === 'en' &&
      entry.data.type === 'essay' &&
      entry.data.status === 'published',
  );
  const essaysPt = content.filter(
    (entry) =>
      entry.data.language === 'pt' &&
      entry.data.type === 'essay' &&
      entry.data.status === 'published',
  );

  return essaysEn.map((essay) => {
    const slug = essay.id.split('/').pop()!;

    // Locate the matching PT translation via translationId
    const ptMatch = essay.data.translationId
      ? essaysPt.find((pt) => pt.data.translationId === essay.data.translationId)
      : undefined;

    const ptSlug = ptMatch ? ptMatch.id.split('/').pop()! : undefined;

    return {
      params: { slug },
      props: { essay, ptSlug },
    };
  });
}

interface Props {
  essay: CollectionEntry<'content'>;
  ptSlug?: string;
}

const { essay, ptSlug } = Astro.props;
const { Content } = await render(essay);

const slug = essay.id.split('/').pop()!;
const enPath = `/en/essays/${slug}`;
const ptPath = ptSlug ? `/pt/ensaios/${ptSlug}` : undefined;
---

<EssayLayout
  title={essay.data.title}
  subtitle={essay.data.subtitle}
  description={essay.data.description}
  date={essay.data.date}
  series={essay.data.series}
  language="en"
  hreflangEn={enPath}
  hreflangPt={ptPath}
  canonical={essay.data.canonicalUrl ?? enPath}
  languagePathEn={enPath}
  languagePathPt={ptPath ?? '/pt/'}
>
  <Content />
</EssayLayout>
