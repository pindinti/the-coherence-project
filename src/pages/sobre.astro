---
import { getCollection, render } from 'astro:content';
import PageLayout from '../layouts/PageLayout.astro';

const content = await getCollection('content');
const page = content.find((entry) =>
  entry.data.language === 'pt' &&
  entry.data.type === 'page' &&
  entry.data.status === 'published' &&
  entry.data.translationId === 'page-about'
);

if (!page) {
  throw new Error('Published Portuguese About page not found.');
}

const englishPage = content.find((entry) =>
  entry.data.language === 'en' &&
  entry.data.type === 'page' &&
  entry.data.status === 'published' &&
  entry.data.translationId === page.data.translationId
);

const { Content } = await render(page);
const ptPath = '/sobre';
const enPath = englishPage ? '/en/about' : undefined;
---

<PageLayout
  title={page.data.title}
  subtitle={page.data.subtitle}
  description={page.data.description}
  language="pt"
  canonical={page.data.canonicalUrl ?? ptPath}
  hreflangEn={enPath}
  hreflangPt={ptPath}
  languagePathEn={enPath ?? '/en/'}
  languagePathPt={ptPath}
>
  <Content />
</PageLayout>
