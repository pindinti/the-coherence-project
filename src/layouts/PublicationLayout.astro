---
import BaseLayout from './BaseLayout.astro';
import ReadingNavigation from '../components/ReadingNavigation.astro';

interface Props {
  title: string;
  subtitle?: string;
  description: string;
  date: Date;
  series?: string;
  language: 'en' | 'pt';
  hreflangEn?: string;
  hreflangPt?: string;
  canonical?: string;
  languagePathEn?: string;
  languagePathPt?: string;
  readingNavigation?: {
    collection: 'essays' | 'articles' | 'journal';
    language: 'en' | 'pt';
    backHref: string;
    previous?: { href: string; title: string };
    next?: { href: string; title: string };
  };
}

const {
  title,
  subtitle,
  description,
  date,
  series,
  language,
  hreflangEn,
  hreflangPt,
  canonical,
  languagePathEn,
  languagePathPt,
  readingNavigation,
} = Astro.props;

const dateFormatted = date.toLocaleDateString(language === 'pt' ? 'pt-BR' : 'en-US', {
  year: 'numeric',
  month: 'long',
  day: 'numeric',
});
---

<BaseLayout
  title={title}
  description={description}
  lang={language}
  hreflangEn={hreflangEn}
  hreflangPt={hreflangPt}
  canonical={canonical}
  languagePathEn={languagePathEn}
  languagePathPt={languagePathPt}
>
  <div class="publication-wrapper">
    <article class="publication">
      <header class="publication-header">
        {series && <p class="publication-series">{series}</p>}
        <h1 class="publication-title">{title}</h1>
        {subtitle && <p class="publication-subtitle">{subtitle}</p>}
        <time class="publication-date" datetime={date.toISOString()}>
          {dateFormatted}
        </time>
      </header>

      <div class="publication-body prose">
        <slot />
      </div>
      {readingNavigation && <ReadingNavigation {...readingNavigation} />}
    </article>
  </div>
</BaseLayout>

<style>
  .publication-wrapper {
    min-height: 100dvh;
    padding: var(--space-16) var(--space-6);
  }

  .publication {
    max-width: var(--max-width-prose);
    margin-inline: auto;
  }

  .publication-header {
    margin-bottom: var(--space-8);
    padding-bottom: var(--space-8);
    border-bottom: 1px solid var(--color-border);
  }

  .publication-series {
    margin-bottom: var(--space-4);
    color: var(--color-accent);
    font-size: var(--text-xs);
    font-weight: var(--weight-semibold);
    letter-spacing: 0.1em;
    text-transform: uppercase;
  }

  .publication-title {
    margin-bottom: var(--space-4);
    font-size: var(--text-4xl);
    font-weight: var(--weight-bold);
    letter-spacing: -0.02em;
    line-height: var(--leading-tight);
  }

  .publication-subtitle {
    margin-bottom: var(--space-6);
    color: var(--color-text-secondary);
    font-size: var(--text-xl);
    font-style: italic;
    line-height: var(--leading-snug);
  }

  .publication-date {
    display: block;
    color: var(--color-text-muted);
    font-size: var(--text-sm);
  }

  .publication-body {
    margin-top: var(--space-8);
  }

  @media (max-width: 768px) {
    .publication-wrapper {
      padding: var(--space-8) var(--space-4);
    }

    .publication-title {
      font-size: var(--text-3xl);
    }
  }
</style>
