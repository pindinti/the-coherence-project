---
/**
 * BaseLayout — The Coherence Project
 *
 * Base HTML document structure shared by all pages.
 *
 * Canonical and hreflang metadata is generated from the production origin
 * configured in astro.config.mjs. Architecture ref:
 * 11_URL_and_Routing_Strategy.md
 */

import '../styles/global.css';
import LanguageSelector from '../components/LanguageSelector.astro';

interface Props {
  /** Page title — rendered in <title> and og:title */
  title: string;
  /** Page description — rendered in meta description and og:description */
  description: string;
  /** Document language code, e.g. "en" or "pt". Defaults to "en". */
  lang?: string;
  /** Destination for the English language selector link */
  languagePathEn?: string;
  /** Destination for the Portuguese language selector link */
  languagePathPt?: string;
  /** Path for the English hreflang alternate (e.g. "/en/essays/slug") */
  hreflangEn?: string;
  /** Path for the Portuguese hreflang alternate (e.g. "/pt/ensaios/slug") */
  hreflangPt?: string;
  /** Canonical path or absolute URL override */
  canonical?: string;
}

const {
  title,
  description,
  lang = 'en',
  languagePathEn,
  languagePathPt,
  hreflangEn,
  hreflangPt,
  canonical,
} = Astro.props;

const site = Astro.site;
if (!site) {
  throw new Error('Astro site must be configured for metadata generation.');
}
const abs = (url: string): string => new URL(url, site).toString();
const currentLanguage = Astro.url.pathname.startsWith('/pt/')
  ? 'pt'
  : Astro.url.pathname.startsWith('/en/')
    ? 'en'
    : undefined;
---

<!doctype html>
<html lang={lang}>
  <head>
    <meta charset="UTF-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <meta name="generator" content={Astro.generator} />

    <!-- Primary SEO -->
    <title>{title}</title>
    <meta name="description" content={description} />

    {canonical && (
      <link rel="canonical" href={abs(canonical)} />
    )}

    {hreflangEn && (
      <link rel="alternate" hreflang="en" href={abs(hreflangEn)} />
    )}
    {hreflangPt && (
      <link rel="alternate" hreflang="pt" href={abs(hreflangPt)} />
    )}
    {(hreflangEn || hreflangPt) && (
      <link rel="alternate" hreflang="x-default" href={site.toString()} />
    )}

    <!-- Google Fonts — Inter -->
    <link rel="preconnect" href="https://fonts.googleapis.com" />
    <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin />
    <link
      rel="stylesheet"
      href="https://fonts.googleapis.com/css2?family=Inter:wght@400;500;600;700&display=swap"
    />
  </head>
  <body>
    <LanguageSelector
      currentLanguage={currentLanguage}
      englishPath={languagePathEn}
      portuguesePath={languagePathPt}
    />
    <slot />
  </body>
</html>
