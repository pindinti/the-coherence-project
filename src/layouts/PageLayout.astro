---
import BaseLayout from './BaseLayout.astro';

interface Props {
  title: string;
  subtitle?: string;
  description: string;
  language: 'en' | 'pt';
  hreflangEn?: string;
  hreflangPt?: string;
  canonical?: string;
  languagePathEn?: string;
  languagePathPt?: string;
}

const {
  title,
  subtitle,
  description,
  language,
  hreflangEn,
  hreflangPt,
  canonical,
  languagePathEn,
  languagePathPt,
} = Astro.props;
---

<BaseLayout
  title={title}
  description={description}
  lang={language}
  hreflangEn={hreflangEn}
  hreflangPt={hreflangPt}
  canonical={canonical}
  languagePathEn={languagePathEn}
  languagePathPt={languagePathPt}
>
  <main class="page-wrapper">
    <article class="page-content">
      <header class="page-header">
        <h1>{title}</h1>
        {subtitle && <p class="page-subtitle">{subtitle}</p>}
      </header>

      <div class="page-body prose">
        <slot />
      </div>
    </article>
  </main>
</BaseLayout>

<style>
  .page-wrapper {
    min-height: 100dvh;
    padding: var(--space-16) var(--space-6);
  }

  .page-content {
    max-width: var(--max-width-prose);
    margin-inline: auto;
  }

  .page-header {
    margin-bottom: var(--space-8);
    padding-bottom: var(--space-8);
    border-bottom: 1px solid var(--color-border);
  }

  .page-header h1 {
    font-size: var(--text-4xl);
    font-weight: var(--weight-bold);
    letter-spacing: -0.02em;
    line-height: var(--leading-tight);
  }

  .page-subtitle {
    margin-top: var(--space-4);
    margin-bottom: 0;
    color: var(--color-text-secondary);
    font-size: var(--text-xl);
    font-style: italic;
    line-height: var(--leading-snug);
  }

  .page-body {
    margin-top: var(--space-8);
  }

  .page-body :global(.profile-portrait) {
    float: left;
    width: 128px;
    height: 128px;
    margin: 0 var(--space-6) var(--space-4) 0;
    border-radius: 50%;
    object-fit: cover;
  }

  .page-body :global(.profile-introduction) {
    display: grid;
    grid-template-columns: 128px minmax(0, 1fr);
    gap: var(--space-6);
    align-items: start;
  }

  .page-body :global(.profile-introduction .profile-portrait) {
    float: none;
    margin: 0;
  }

  @media (max-width: 768px) {
    .page-wrapper {
      padding: var(--space-8) var(--space-4);
    }

    .page-header h1 {
      font-size: var(--text-3xl);
    }

    .page-body :global(.profile-portrait) {
      width: 96px;
      height: 96px;
      margin-right: var(--space-4);
    }

    .page-body :global(.profile-introduction) {
      display: flow-root;
    }

    .page-body :global(.profile-introduction .profile-portrait) {
      float: left;
      margin: 0 var(--space-4) var(--space-4) 0;
    }
  }
</style>
