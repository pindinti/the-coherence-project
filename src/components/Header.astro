---
import LanguageSelector from './LanguageSelector.astro';

interface Props {
  currentLanguage?: 'en' | 'pt';
  englishPath?: string;
  portuguesePath?: string;
  homePath: string;
}

const {
  currentLanguage,
  englishPath,
  portuguesePath,
  homePath,
} = Astro.props;

const isEnglish = currentLanguage === 'en';
const pathname = Astro.url.pathname;
const navigation = isEnglish
  ? [
      { label: 'Essays', href: '/en/', active: pathname === '/en/' || pathname.startsWith('/en/essays/') },
      { label: 'Articles', href: '/en/articles/', active: pathname.startsWith('/en/articles/') },
      { label: 'Journal', href: '/en/journal/', active: pathname.startsWith('/en/journal/') },
      { label: 'About', href: '/en/about', active: pathname === '/en/about' || pathname === '/en/about/' },
    ]
  : [
      { label: 'Ensaios', href: '/', active: pathname === '/' || pathname.startsWith('/ensaios/') },
      { label: 'Artigos', href: '/artigos/', active: pathname.startsWith('/artigos/') },
      { label: 'Diário', href: '/diario/', active: pathname.startsWith('/diario/') },
      { label: 'Sobre', href: '/sobre', active: pathname === '/sobre' || pathname === '/sobre/' },
    ];
---

<header class="site-header">
  <div class="site-header__inner">
    <a class="site-header__identity" href={homePath}>
      The Coherence Project
    </a>

    <nav
      class="site-header__navigation"
      aria-label={isEnglish ? 'Primary navigation' : 'Navegação principal'}
    >
      {navigation.map((item) => (
        <a href={item.href} aria-current={item.active ? 'page' : undefined}>
          {item.label}
        </a>
      ))}
    </nav>

    <div class="site-header__language">
      <LanguageSelector
        currentLanguage={currentLanguage}
        englishPath={englishPath}
        portuguesePath={portuguesePath}
      />
    </div>
  </div>
</header>

<style>
  .site-header {
    position: sticky;
    top: 0;
    z-index: 1;
    padding: var(--space-6);
    background-color: var(--color-bg);
  }

  .site-header__inner {
    display: flex;
    align-items: center;
    gap: var(--space-4);
    max-width: var(--max-width-content);
    margin-inline: auto;
  }

  .site-header__identity {
    color: var(--color-text-primary);
    font-size: var(--text-sm);
    font-weight: var(--weight-semibold);
    text-decoration: none;
  }

  .site-header__navigation {
    display: flex;
    align-items: center;
    gap: var(--space-4);
    margin-left: var(--space-4);
    font-size: var(--text-sm);
  }

  .site-header__navigation a {
    color: var(--color-text-secondary);
    text-decoration: none;
  }

  .site-header__navigation a:hover,
  .site-header__navigation a[aria-current='page'] {
    color: var(--color-text-primary);
  }

  .site-header__navigation a[aria-current='page'] {
    font-weight: var(--weight-semibold);
  }

  .site-header__language {
    margin-left: auto;
  }

  @media (max-width: 768px) {
    .site-header {
      padding: var(--space-4);
    }

    .site-header__inner {
      flex-wrap: wrap;
    }

    .site-header__navigation {
      order: 3;
      width: 100%;
      margin-left: 0;
      overflow-x: auto;
    }
  }
</style>
