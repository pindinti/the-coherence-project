---
interface Props {
  caption?: string;
  legend?: string;
  columns?: number;
}

const { caption, legend, columns = 2 } = Astro.props;
const gridColumns = Math.min(Math.max(columns, 1), 3);
---
<figure class="figure-group">
  <div class="figure-group__grid" style={`grid-template-columns: repeat(${gridColumns}, minmax(0, 1fr));`}>
    <slot />
  </div>
  {caption && <figcaption class="figure-group__caption">{caption}</figcaption>}
  {legend && <p class="figure-group__legend">{legend}</p>}
</figure>

<style>
  .figure-group {
    margin: var(--space-12) auto;
    width: 100%;
  }

  .figure-group__grid {
    display: grid;
    gap: var(--space-6);
  }

  .figure-group__caption {
    margin-top: var(--space-4);
    font-size: var(--text-sm);
    color: var(--color-text-muted);
    text-align: center;
  }

  .figure-group__legend {
    margin-top: var(--space-3);
    font-size: var(--text-sm);
    line-height: var(--leading-normal);
    color: var(--color-text-secondary);
    text-align: center;
  }

  @media (max-width: 768px) {
    .figure-group__grid {
      grid-template-columns: 1fr !important;
    }
  }
</style>
