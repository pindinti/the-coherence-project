---
import type { CollectionEntry } from 'astro:content';

interface Props {
  essays: CollectionEntry<'content'>[];
  language: 'en' | 'pt';
}

const { essays, language } = Astro.props;
const isPortuguese = language === 'pt';
const basePath = isPortuguese ? '/ensaios' : '/en/essays';
---

<div class="page">
  <header class="page-header">
    <h1 class="page-title">{isPortuguese ? 'Ensaios' : 'Essays'}</h1>
  </header>

  <main class="page-main">
    {essays.length > 0 ? (
      <ul class="essay-list" role="list">
        {essays.map((essay) => {
          const slug = essay.id.split('/').pop()!;
          return (
            <li class="essay-item">
              <a href={`${basePath}/${slug}`} class="essay-link">
                <article class="essay-card">
                  {essay.data.series && (
                    <span class="essay-card-series">{essay.data.series}</span>
                  )}
                  <h2 class="essay-card-title">{essay.data.title}</h2>
                  {essay.data.subtitle && (
                    <p class="essay-card-subtitle">{essay.data.subtitle}</p>
                  )}
                  <p class="essay-card-description">{essay.data.description}</p>
                  <time
                    class="essay-card-date"
                    datetime={essay.data.date.toISOString()}
                  >
                    {essay.data.date.toLocaleDateString(isPortuguese ? 'pt-BR' : 'en-US', {
                      year: 'numeric',
                      month: 'long',
                      day: 'numeric',
                    })}
                  </time>
                </article>
              </a>
            </li>
          );
        })}
      </ul>
    ) : (
      <p class="empty-state">
        {isPortuguese ? 'Nenhum ensaio publicado ainda.' : 'No published essays yet.'}
      </p>
    )}
  </main>
</div>

<style>
  .page {
    max-width: var(--max-width-content);
    margin-inline: auto;
    padding: var(--space-16) var(--space-6);
  }

  .page-header {
    margin-bottom: var(--space-12);
  }

  .page-title {
    font-size: var(--text-4xl);
    font-weight: var(--weight-bold);
    letter-spacing: -0.02em;
  }

  .essay-list {
    display: flex;
    flex-direction: column;
    max-width: 56rem;
    list-style: none;
  }

  .essay-item:not(:last-child) {
    border-bottom: 1px solid var(--color-border);
  }

  .essay-link {
    display: block;
    padding: var(--space-8) 0;
    color: inherit;
    text-decoration: none;
    transition: opacity var(--transition-fast);
  }

  .essay-link:hover {
    opacity: 0.7;
  }

  .essay-card-series {
    display: inline-block;
    margin-bottom: var(--space-3);
    color: var(--color-accent);
    font-size: var(--text-xs);
    font-weight: var(--weight-semibold);
    letter-spacing: 0.1em;
    text-transform: uppercase;
  }

  .essay-card-title {
    margin-bottom: var(--space-2);
    font-size: var(--text-2xl);
    font-weight: var(--weight-semibold);
    line-height: var(--leading-snug);
  }

  .essay-card-subtitle {
    margin-bottom: var(--space-4);
    color: var(--color-text-secondary);
    font-size: var(--text-base);
    font-style: italic;
    line-height: var(--leading-snug);
  }

  .essay-card-description {
    max-width: 52ch;
    margin-bottom: var(--space-4);
    color: var(--color-text-secondary);
    font-size: var(--text-sm);
    line-height: var(--leading-relaxed);
  }

  .essay-card-date {
    color: var(--color-text-muted);
    font-size: var(--text-xs);
  }

  .empty-state {
    padding: var(--space-8) 0;
    color: var(--color-text-muted);
    font-style: italic;
  }

  @media (max-width: 768px) {
    .page {
      padding: var(--space-8) var(--space-4);
    }

    .page-title {
      font-size: var(--text-3xl);
    }

    .essay-card-title {
      font-size: var(--text-xl);
    }
  }
</style>
